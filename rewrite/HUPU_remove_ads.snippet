# 虎扑去广告 — Quantumult X
# 原作者：ZenmoFeiShi https://github.com/ZenmoFeiShi
# 适配日期：2026-11-01；保留源规则的版本范围与处理项目。
# 需要开启重写、HTTPS 解密，并安装且信任 Quantumult X 证书。
hostname = games.mobileapi.hupu.com, fairy.mobileapi.hupu.com, bbs.mobileapi.hupu.com, goblin.hupu.com

(?i)^https://games\.mobileapi\.hupu\.com/\d/\d\.\d\.\d+/bplapi/reddot/v1/app/getReddot url reject-dict
(?i)^https://bbs\.mobileapi\.hupu\.com/\d/\d\.\d\.\d+/(bbsallapi/tag/v1/heatTag|bbsrankapi/v1/rating/list) url reject-dict
(?i)^https://games\.mobileapi\.hupu\.com/\d/\d\.\d\.\d+/search/v2/(hintkeylist|hotkeylist) url reject-dict
(?i)^https://goblin\.hupu\.com/\d/\d\.\d\.\d+/interfaceAd/getOther/v\d url reject-dict
(?i)^https://goblin\.hupu\.com/\d/\d\.\d\.\d+/interfaceAd/getOther/batch url reject-dict
(?i)^https://fairy\.mobileapi\.hupu\.com/gallery/getmod2 url reject-200
(?i)^https://games\.mobileapi\.hupu\.com/3/8\.0\.86/bplcommentapi/bpl/score_tab/groups url reject-dict
(?i)^https://games\.mobileapi\.hupu\.com/3/8\.0\.86/bplapi/banner/getLocationBanners url reject-dict
(?i)^https://fairy\.mobileapi\.hupu\.com/mang/preview/banners url script-response-body https://raw.githubusercontent.com/bbnotcode/quantumultx-scripts/main/scripts/HUPU_remove_ads.js
(?i)^https://bbs\.mobileapi\.hupu\.com/\d/\d\.\d\.\d+/bbsallapi/lego/data url script-response-body https://raw.githubusercontent.com/bbnotcode/quantumultx-scripts/main/scripts/HUPU_remove_ads.js
(?i)^https://games\.mobileapi\.hupu\.com/\d/\d\.\d\.\d+/buffer/hotList url script-response-body https://raw.githubusercontent.com/bbnotcode/quantumultx-scripts/main/scripts/HUPU_remove_ads.js
(?i)^https://games\.mobileapi\.hupu\.com/\d/\d\.\d\.\d+/bplapi/user/v1/more url script-response-body https://raw.githubusercontent.com/bbnotcode/quantumultx-scripts/main/scripts/HUPU_remove_ads.js
